# =============================================================================
# Genba Management System — .gitignore
# =============================================================================

# Environment files — NEVER commit secrets
.env
.env.local
.env.production
.env.staging

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
pip-wheel-metadata/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Alembic
# Keep versions but ignore auto-generated __pycache__
backend/app/migrations/versions/__pycache__/

# Node.js / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Generated types — committed to git for CI (see integration-conventions.md §2.3)
# frontend/types/api.generated.ts  # DO NOT ignore this file

# Docker
.dockerignore

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
Thumbs.db
ehthumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# SSL certificates (local dev only — never commit real certs)
nginx/ssl/
!nginx/ssl/.gitkeep

# Database dumps
*.dump
*.sql.gz
/backups/

# Test artifacts
test-results/
playwright-report/
