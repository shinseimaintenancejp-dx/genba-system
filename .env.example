# =============================================================================
# Genba Management System — Environment Variables Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
DB_USER=genba_user
DB_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://genba_user:change_me_in_production@db:5432/genba_management

# -----------------------------------------------------------------------------
# Redis 7
# HIGH-05 Fix: Redis now requires password authentication
# Generate: openssl rand -hex 24
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
REDIS_PASSWORD=change_me_redis_password

# -----------------------------------------------------------------------------
# JWT Authentication
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (cloud-agnostic)
# Supports: Cloudflare R2, Wasabi, MinIO, or any S3-compatible provider
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_access_key_here
STORAGE_SECRET_KEY=your_secret_key_here
STORAGE_BUCKET_NAME=genba-management
STORAGE_REGION=apac

# -----------------------------------------------------------------------------
# Data Encryption (pgcrypto AES-256)
# Generate: openssl rand -hex 32
# NEVER log or expose this key
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Feature flags — comma-separated module names, or 'all' for full access.
# Dev: ENABLED_MODULES=all
# Prod: ENABLED_MODULES=genba (add more as each sprint is released)
ENABLED_MODULES=all

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Must match ENABLED_MODULES on backend
NEXT_PUBLIC_ENABLED_MODULES=all
